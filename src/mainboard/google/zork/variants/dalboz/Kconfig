if BOARD_GOOGLE_DALBOZ

menu "APCB Config options"

config PSP_APCB_FILE
	string "APCB file for SPD0"
	# HMA851S6CJR6N-VK - 0000b
	default "3rdparty/blobs/mainboard/google/zork/APCB_HMA851S6CJR6N-VK_x1.bin"
	help
	  The name of the AGESA Parameter Customization Block.  This image is
	  instance ID 0 in the PSP's BIOS Directory Table.

config PSP_APCB1_FILE
	string "APCB file for SPD1"
	# HMAA1GS6CMR6N-VK - 0001b
	default "3rdparty/blobs/mainboard/google/zork/APCB_HMAA1GS6CMR6N-VK_x2.bin"
	help
	  If specified, this image is instance ID 1 in the PSP's BIOS
	  Directory Table.

config PSP_APCB2_FILE
	string "APCB file for SPD2"
	# default ""
	help
	  If specified, this image is instance ID 2 in the PSP's BIOS
	  Directory Table.

config PSP_APCB3_FILE
	string "APCB file for SPD3"
	# default ""
	help
	  If specified, this image is instance ID 3 in the PSP's BIOS
	  Directory Table.

config PSP_APCB4_FILE
	string "APCB file for SPD4"
	# default ""
	help
	  If specified, this image is instance ID 4 in the PSP's BIOS
	  Directory Table.

endmenu

endif #BOARD_GOOGLE_DALBOZ
